using Gtk 4.0;
using Adw 1;

template $SettingsDialog: Adw.PreferencesDialog {
  title: _("Settings");

  Adw.PreferencesPage {
    Adw.PreferencesGroup data_group {
      title: _("Data");

      Adw.EntryRow data_dir_entry {
        title: _("Data Directory");

        [suffix]
        Button {
          icon-name: "external-link-symbolic";
          valign: center;
          clicked => $on_dir_clicked();

          styles [
            "flat",
          ]
        }

        Button {
          icon-name: "folder-open-symbolic";
          valign: center;
          clicked => $on_picker_clicked();

          styles [
            "flat",
          ]
        }
      }

      Adw.ButtonRow {
        title: _("Reset Data Directory");
        activated => $on_reset_data_dir();
      }

      Adw.ButtonRow {
        sensitive: false;
        title: _("Delete All Games");
        activated => $on_delete_games();

        styles [
          "destructive-action",
        ]
      }
    }

    Adw.PreferencesGroup online_group {
      title: _("Online");

      Adw.SwitchRow discord_rpc_switch {
        title: _("Enable Discord RPC");
      }

      Adw.SwitchRow updates_switch {
        title: _("Suppress Update Toasts");
      }

      Adw.ButtonRow {
        title: _("Check for Updates");
        activated => $on_check_updates();
      }
    }

    Adw.PreferencesGroup files_group {
      title: _("Files");

      Adw.SwitchRow delete_import_switch {
        title: _("Delete Source After Importing");
      }
      Adw.SwitchRow windowficate_switch {
        title: _("Restrict Filenames");
        subtitle: _("Restrict filenames to Windows-compatible characters");
      }
      Adw.SwitchRow use_trash_switch {
        title: _("Move to Trash");
        subtitle: _("Instead of deleting permanently");
      }
    }

    Adw.PreferencesGroup comp_group {
      title: _("Compatibility");
      visible: false;  // currently windows only

      Adw.SwitchRow reduce_motion_switch {
        title: _("Force Reduce Motion");
        subtitle: _("Disable animations to reduce lag on Windows");
      }

      Adw.SwitchRow disable_hidpi_switch {
        title: _("Use Legacy Scaling");
        subtitle: _("Scale the app to sizes like 150% through Windows. May look blurry. Requires restart");
      }
    }

    Adw.PreferencesGroup config_group {
      description: _("These might break some games. Here be dragons!");
      title: _("Game Defaults");

      Adw.SwitchRow skip_splash_scr_switch {
        title: _("Skip Splash Screen");
      }

      Adw.SwitchRow skip_main_menu_switch {
        title: _("Skip Main Menu");
      }

      Adw.SwitchRow forced_save_dir_switch {
        title: _("Contained Game Saves");
      }
    }
  }
}
